# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real secrets.
# On Vercel, set the same variables in Project Settings -> Environment Variables
# (see README, "Private access").
#
# Conventions:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Everything else is server-only. Never give these two a NEXT_PUBLIC_ prefix.

# --- Private access gate (required) -----------------------------------------
# If either value is missing or too short, nobody can sign in (it fails closed).

# The one passphrase that unlocks the site. Use a long, unique phrase.
APP_PASSPHRASE=

# Secret used to sign the session cookie. At least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Changing either value signs out every existing session.

# --- Other settings ---------------------------------------------------------
# No other variables are required yet. Specifics will be added in later steps.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
