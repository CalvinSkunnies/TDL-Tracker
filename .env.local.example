# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real secrets.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
#
# No variables are required yet. Specifics will be added in later steps.
#
# Conventions:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - Everything else is server-only.

# NEXT_PUBLIC_APP_URL=http://localhost:3000
